#!/bin/bash
# Bootstrap instance backend ASG (dipanggil oleh Launch Template Terraform).
#
# Jalur request: ALB -> Nginx :80 -> Gunicorn 127.0.0.1:8000 -> Django.
# Nginx, Gunicorn, systemd unit, dan environment disiapkan oleh
# deploy/scripts/setup-ec2.sh dari branch yang sama dengan backend.
set -euo pipefail

exec > >(tee -a /var/log/pos-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl git

if [[ ! -d /opt/pos/.git ]]; then
  mkdir -p /opt
  git clone --depth 1 --branch "${backend_git_ref}" "${backend_repo_url}" /opt/pos
fi

if [[ -n "${efs_file_system_id}" ]]; then
  curl -fsSL https://amazon-efs-utils.aws.com/efs-utils-installer.sh \
    -o /tmp/efs-utils-installer.sh
  bash /tmp/efs-utils-installer.sh --install
  rm -f /tmp/efs-utils-installer.sh

  bash /opt/pos/infra/aws/scripts/setup-efs-mount.sh \
    "${efs_file_system_id}" "${efs_region}" "${efs_access_point_id}"
  export POS_DATA_FILE=/mnt/pos-efs/data_store.json
fi

# setup-ec2.sh idempoten: tidak menimpa /etc/pos/backend.env yang sudah ada.
DJANGO_ALLOWED_HOSTS="${django_allowed_hosts}" \
CORS_ALLOWED_ORIGINS="${cors_allowed_origins}" \
REPO_URL="${backend_repo_url}" \
BRANCH="${backend_git_ref}" \
  bash /opt/pos/deploy/scripts/setup-ec2.sh

systemctl status pos-backend --no-pager
systemctl status nginx --no-pager
curl -fsS http://127.0.0.1:8000/api/health/
curl -fsS http://127.0.0.1/api/health/
