#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/pos-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y git python3-venv python3-pip

mkdir -p /opt/toko-maju-pos
git clone --depth 1 --branch "${backend_git_ref}" "${backend_repo_url}" /opt/toko-maju-pos/repo
cd /opt/toko-maju-pos/repo/backend_django

python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r requirements.txt

cat > /etc/pos-backend.env <<ENV_VARS
DJANGO_SECRET_KEY=$(openssl rand -base64 48)
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=${django_allowed_hosts}
ENV_VARS
chmod 600 /etc/pos-backend.env
chown -R ubuntu:ubuntu /opt/toko-maju-pos

cat > /etc/systemd/system/pos-backend.service <<'SERVICE'
[Unit]
Description=Toko Maju POS Django API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/toko-maju-pos/repo/backend_django
EnvironmentFile=/etc/pos-backend.env
ExecStart=/opt/toko-maju-pos/repo/backend_django/.venv/bin/gunicorn pos_backend.wsgi:application --bind 0.0.0.0:8000 --workers 1 --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now pos-backend.service
