#!/bin/bash
# Cloud-init template untuk EC2. Dijalankan otomatis oleh Terraform.
# Placeholder ${branch} dan ${repo_url} diisi oleh templatefile().
set -euxo pipefail

apt-get update -y
apt-get install -y git

if [ ! -d /opt/pos/.git ]; then
  git clone --branch ${branch} ${repo_url} /opt/pos
fi

bash /opt/pos/deploy/scripts/setup-ec2.sh
