# Build-time frontend configuration untuk Vite.
# Salin ke `.env.production` atau ekspor saat `npm run build`.

# Opsi 1 (direkomendasikan untuk arsitektur laporan):
# frontend di CloudFront, API langsung ke ALB.
VITE_API_BASE_URL=https://alb-dns-name/api

# Opsi 2 (same-origin): jika CloudFront juga mem-proxy /api ke ALB.
# VITE_API_BASE_URL=/api
