# Environment backend Django (dibaca oleh systemd EnvironmentFile).
# Salin ke /etc/pos/backend.env, lalu sesuaikan.

# Wajib False di produksi.
DEBUG=False

# Generate dengan: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-random-secret

# Pisahkan dengan koma. Tambahkan public IP EC2, DNS ALB, dan domain CloudFront
# bila backend diakses langsung.
ALLOWED_HOSTS=localhost,127.0.0.1,ec2-public-ip,alb-dns-name

# CORS: frontend CloudFront harus diizinkan.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://dxxxxxxxxxxxxx.cloudfront.net,http://localhost:8080

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_TIMEOUT=60
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-
GUNICORN_LOG_LEVEL=info

# Dipakai endpoint /api/health/ agar load balancer bisa membedakan instance.
INSTANCE_ID=

# Catatan: DATA_STORE_PATH / EFS dikelola oleh Distributed Storage Engineer.
# Jangan menaruh kredensial AWS di file ini.
